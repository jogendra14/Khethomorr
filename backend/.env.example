# Local MongoDB example. Start MongoDB locally before using this URL.
MONGO_URI=mongodb://127.0.0.1:27017/khethomorr

# Use a long, unique random value in your real .env file.
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000

# Required only when using image upload features.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when using email features.
GMAIL_USER=
GMAIL_PASS=

# Required only when using Razorpay payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
